  name      String   @unique // Örn: İSG Tutanağı, İş Sözleşmesi vb.
  content   String   @db.Text // İçinde {{PERSONEL_ADI}}, {{PROJE_ADI}}, {{TARİH}} gibi dinamik değişkenler
  createdAt DateTime @default(now())

  contracts Contract[]
}
