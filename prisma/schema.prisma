// ============================================================================
// ATTENDANCE RECORD (Personel Yoklama Kayıtları)
// ============================================================================

model AttendanceRecord {
  id            String   @id @default(cuid())
  personelId    String?
  personel      Personel? @relation(fields: [personelId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date          DateTime // Sadece gün bazlı tarih
  checkIn       DateTime? // Giriş saati
  checkOut      DateTime? // Çıkış saati
  status        String   @default("PRESENT") // PRESENT, LATE, ABSENT
  dayMultiplier Float    @default(1) // Tam gün için 1, yarım gün için 0.5
  overtimeHours Float?   @default(0) // Fazla mesai saati
  workerName    String?  // GPS bazlı check-in için isim
  latitude      Float?   // GPS check-in koordinatı
  longitude     Float?   // GPS check-in koordinatı
  createdAt     DateTime @default(now())

