// ============================================================================
// DOCUMENT (Versiyonlu Evraklar - Google Drive Entegrasyonu)
// ============================================================================

model Document {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  type              String   // RUHSAT, STATIK_PROJE, MIMARI_PROJE, YAPI_KULLANMA, DIGER
  version           Int      @default(1)
  googleDriveFileId String   // Google Drive dosya ID'si
  googleDriveUrl    String?  // Google Drive paylaşım linki
  uploadedById      String
  uploadedBy        User     @relation(fields: [uploadedById], references: [id])
  status            String   @default("ACTIVE") // ACTIVE, OBSOLETE, DELETED
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([version])
  @@index([uploadedById])
  @@index([status])
}

// ============================================================================
// AUDIT LOG (Değiştirilemez Log Sistemi)
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // STATUS_CHANGE, DELETE, UPDATE, CREATE
  entityId    String   // İlgili kayıt ID'si
  entityType  String   // DEFICIENCY, INSPECTION, PROJECT, PERSONEL, vb.
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  reason      String   @db.Text // İşlem nedeni/açıklama
  ipAddress   String?  // IP adresi
  metadata    String?  @db.Text // Ek JSON verileri
  deficiency  Deficiency? @relation(fields: [entityId], references: [id])
  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([entityType])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
