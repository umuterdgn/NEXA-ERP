// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER AND AUTHENTICATION
// ============================================================================

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  password                 String
  name                     String
  role                     UserRole                  @default(ADMIN)
  permissions              String[]                  @default([]) // Modül yetkileri
  profileImage             String?
  companyType              CompanyType?              @default(MAIN_CONTRACTOR) // SaaS: Firma türü
  companyId                String? // SaaS: Firma / Organizasyon ID
  company                  Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  bleDevice                BleDevice?
  tenantId                 String? // SaaS: Kiracı ID
  tenant                   Tenant?                   @relation("UserTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  organizationId           String? // Ortak Katman: Organizasyon ID
  organization             Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  managedProjects          Project[]                 @relation("ProjectManager")
  activityLogs             ActivityLog[]
  inventory                Inventory[]
  messages                 Message[]
  conversationParticipants ConversationParticipant[]
  approvedOrders           PurchaseOrder[]
  uploadedDocuments        ProjectDocument[]
  uploadedDocs             Document[]
  auditLogs                AuditLog[]
  locationLogs             LocationLog[]
  attachments              Attachment[]
  digitalArchives          DigitalArchive[]
  projectRevisions         ProjectRevision[]
  digitalDrawings          DigitalDrawing[]
  receivedLogistics        LogisticsSchedule[]       @relation("LogisticsReceivedBy")
  formSubmissions          FormSubmission[]
  approvalWorkflows        ApprovalWorkflow[]
  documentRevisions        DocumentRevision[]
  coreSamplesTaken         CoreSample[]
  leaveRequests            LeaveRequest[]
  advanceRequests          AdvanceRequest[]
  personnelDocuments       PersonnelDocument[]

  @@index([companyId])
  @@index([organizationId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SITE_MANAGER
  MUHASEBE
  STAFF
  ENGINEER
  SUBCONTRACTOR
  CLIENT
  MUTEAHHIT
  INSPECTION_ADMIN
  INSPECTOR
  AUDITOR
  WORKER
  SUPPLIER
  HR_MANAGER
  FINANCE_MANAGER
  PROCUREMENT_MANAGER
  EQUIPMENT_MANAGER
  ISG_EXPERT
  DRIVER
}

enum CompanyType {
  MAIN_CONTRACTOR
  SUBCONTRACTOR
  SUPPLIER
  CLIENT
  INSPECTION
}

// ============================================================================
// TENANT (SaaS Multi-Tenancy)
// ============================================================================

model Tenant {
  id        String      @id @default(cuid())
  name      String // Şirket adı
  domain    String? // Özel domain (opsiyonel)
  type      CompanyType @default(MAIN_CONTRACTOR) // Firma türü
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  projects    Project[]
  personnel   Personel[]
  equipment   Equipment[]
  droneMedia  DroneMedia[]
  chatThreads ChatThread[]
  systemLogs  SystemLog[]
  users       User[]       @relation("UserTenant")

  @@index([isActive])
  @@index([type])
}

// ============================================================================
// CMS CONTENT
// ============================================================================

model About {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  videoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text
  images         String[] // JSON array of image URLs (max 5)
  threeDModelUrl String? // .glb or .gltf URL for 3D model
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model PortfolioProject {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  imageUrl     String?
  images       String[] @default([])
  year         String?
  location     String?
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
}

model Project {
  id                       String                    @id @default(cuid())
  title                    String
  description              String                    @db.Text
  images                   String[] // JSON array of image URLs (max 5)
  threeDModelUrl           String? // .glb or .gltf URL for 3D model
  year                     String?
  location                 String?
  isActive                 Boolean                   @default(true)
  displayOrder             Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  // ERP Project fields
  name                     String?
  status                   String? // ETUT, CIZIM, SAHA, TAMAMLANDI
  companyId                String?
  company                  Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tenantId                 String?
  tenant                   Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organizationId           String?
  organization             Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  startDate                DateTime                  @default(now())
  endDate                  DateTime?
  managerId                String? // Projeye atanan şantiye şefinin ID'si
  manager                  User?                     @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  engineers                String[]                  @default([]) // Mühendis ID'leri
  architects               String[]                  @default([]) // Mimar ID'leri
  siteManager              String? // Şantiye Şefi (isim)
  engineer                 String? // Sorumlu Mühendis (isim)
  architect                String? // Mimar (isim)
  // New categorization and location fields
  category                 String? // "Güçlendirme", "Paket İş", "Kentsel Dönüşüm", "Performans Analizi", "Danışmanlık", "Şantiye Şefliği" vb.
  city                     String?
  district                 String?
  mintika                  String?
  ada                      String?
  parsel                   String?
  pafta                    String? // Pafta bilgisi (YİBF/Tapu)
  yapiSinifi               String? // Yapı sınıfı (YİBF/Tapu)
  clientName               String? // Firma / Müşteri Adı
  mapUrl                   String? // Google Maps Linki
  shiftStart               String                    @default("08:00") // Mesai Başlangıç Saati
  shiftEnd                 String                    @default("17:00") // Mesai Bitiş Saati
  // Digital Twin / YİBF fields
  yibfNo                   String?                   @unique // Yapı İzleme Belgesi Numarası
  totalArea                Float? // Toplam inşaat alanı (m2)
  totalConstructionArea    Float? // Toplam inşaat alanı (YİBF)
  buildingClass            String? // Yapı Sınıfı (Örn: 3B, IV-A)
  yibfStatus               String? // "Ruhsat Bekliyor", "Aktif Şantiye", "İskan Aşamasında" vb.
  lastYibfSync             DateTime? // Son YİBF bakanlık senkronizasyon zamanı
  healthScore              Int                       @default(100) // Proje sağlık skoru (0-100)
  progress                 Int                       @default(0) // İlerleme yüzdesi (0-100)
  // Geofencing (GPS) fields
  gpsRequired              Boolean                   @default(false) // Girişlerde GPS doğrulaması zorunlu mu?
  latitude                 Float? // Proje merkezi enlem
  longitude                Float? // Proje merkezi boylam
  gpsRadius                Float?                    @default(100) // Metre cinsinden izin verilen çap
  geofenceRadius           Float?                    @default(100) // Güvenlik/çit alanı metre cinsinden çap (uyumluluk)
  ifcModelUrl              String? // 3D BIM modelinin dosya yolu (.ifc)
  bimModelUrl              String? // 3D BIM model URL (.ifc)
  locationCity             String? // Proje lokasyon şehri (hava durumu için)
  contractValue            Float? // Sözleşme bedeli (hakediş hesaplamaları için)
  // Relations
  coreSamples              CoreSample[]
  yibfDocuments            YibfDocument[]
  archives                 Archive[]
  transactions             Transaction[]
  movements                StockMovement[]
  siteReports              SiteReport[]
  equipments               Equipment[]
  contracts                Contract[]
  personnelContracts       PersonnelContract[]
  inventory                Inventory[]
  attendanceRecords        AttendanceRecord[]
  visitorRecords           VisitorRecord[]
  siteTasks                SiteTask[]
  activityLogs             ActivityLog[]
  reminders                Reminder[]
  projectFiles             ProjectFile[]
  dailyLogs                DailyLog[]
  inspectionReports        InspectionReport[]
  tasks                    Task[]
  isgReports               IsgReport[]
  concreteTests            ConcreteTest[]
  coreTests                CoreTest[]
  documentArchives         DocumentArchive[]
  projectBlueprints        ProjectBlueprint[]
  reinforcementInspections ReinforcementInspection[]
  attachmentEvidences      AttachmentEvidence[]
  audits                   Audit[]
  dailyProgress            DailyProgress[]
  bimIssues                BimIssue[]
  subcontractorContracts   SubcontractorContract[]
  deductions               Deduction[]
  materialRequests         MaterialRequest[]
  projectTasks             ProjectTask[]
  projectDocuments         ProjectDocument[]
  inventoryItems           InventoryItem[]
  siteZones                SiteZone[]
  workOrders               WorkOrder[]
  droneMedia               DroneMedia[]
  chatThreads              ChatThread[]
  announcements            Announcement[]
  documents                Document[]
  inspections              Inspection[]
  deficiencies             Deficiency[]
  shifts                   Shift[]
  aiAnalyses               AIAnalysis[]
  droneAnalyses            DroneAnalysis[]
  labDocuments             LabDocument[]
  rebarFormworkChecks      RebarFormworkCheck[]
  attachments              Attachment[]
  licenseArchives          LicenseArchive[]
  digitalArchives          DigitalArchive[]
  ocrDocuments             OCRDocument[]
  aiImageAnalyses          AIImageAnalysis[]
  projectRevisions         ProjectRevision[]
  digitalDrawings          DigitalDrawing[]
  auditRecords             AuditRecord[]
  materialApprovals        MaterialApproval[]
  nonconformityDOFs        NonconformityDOF[]
  nearMisses               NearMiss[]
  ppeAssignments           PPEAssignment[]
  logisticsAppointments    LogisticsAppointment[]
  logisticsSchedules       LogisticsSchedule[]       @relation("ProjectLogistics")
  foodMenus                FoodMenu[]
  formSubmissions          FormSubmission[]
  bimFiles                 BimFile[]
  workPackages             WorkPackage[]
  boqItems                 BoQItem[]
  progressPayments         ProgressPayment[]
  financialTransactions    FinancialTransaction[]
  auditLogs                AuditLog[]
  approvalRequests         ApprovalRequest[]
  bimElementMaps           BimElementMap[]
  backgroundJobs           BackgroundJob[]
  dailyAiReports           DailyAiReport[]
  purchaseRequests         PurchaseRequest[]

  @@index([isActive, displayOrder])
  @@index([status])
  @@index([companyId])
  @@index([organizationId])
  @@index([managerId])
  @@index([category])
  @@index([city])
  @@index([district])
}

// ============================================================================
// SITE ZONES (Vaziyet Planı)
// ============================================================================

model SiteZone {
  id                 String   @id @default(cuid())
  projectId          String
  title              String // Örn: "A Blok Oturumu", "Demir Büküm Alanı"
  category           String? // RISK, BUILDING, REST_AREA, STORAGE (Legacy)
  zoneType           String   @default("MAIN_SITE") // MAIN_SITE, DANGER_ZONE, REST_AREA
  latitude           Float?
  longitude          Float?
  radius             Float?   @default(20) // Opsiyonel legacy alan büyüklüğü
  polygonCoordinates Json? // [{lat: number, lng: number}, ...] köşe koordinatları dizisi
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([zoneType])
  @@index([category])
}

// ============================================================================
// CORE SAMPLES (Karot/Numune Takip Tablosu)
// ============================================================================

model CoreSample {
  id              String    @id @default(cuid())
  qrCode          String    @unique // Fiziksel QR barkod numarası
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  takenBy         User      @relation(fields: [takenById], references: [id], onDelete: Cascade) // Numuneyi alan denetçi
  takenById       String
  location        String    // Örn: "A Blok, 3. Kat Kolon"
  status          String    @default("TAKEN") // TAKEN, IN_LAB, TESTED
  takenAt         DateTime  @default(now())
  testedAt        DateTime?
  resultStrength  Float?    // Laboratuvar kırım sonucu (MPa vb.)
  isPassed        Boolean?  // İstenilen dayanıma ulaştı mı?
  reportFileUrl   String?   // Yüklenen OCR PDF/Resim dosyası (UploadThing)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([projectId])
  @@index([takenById])
  @@index([qrCode])
  @@index([status])
}

// ============================================================================
// YİBF DOCUMENTS (Resmi Tutanaklar ve Denetim Kayıtları)
// ============================================================================

model YibfDocument {
  id           String   @id @default(cuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  documentType String   // Örn: "Seviye Tespit Tutanağı", "Beton Döküm Tutanağı"
  documentDate DateTime
  externalUrl  String?  // Bakanlık sistemindeki evrak indirme linki (varsa)
  createdAt    DateTime @default(now())

  @@index([projectId])
}

// ============================================================================
// ARCHIVE (Google Drive PDFs)
// ============================================================================

model Archive {
  id           String   @id @default(cuid())
  projectName  String
  fileName     String
  documentName String?
  driveUrl     String
  uploadedAt   DateTime @default(now())
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectName])
  @@index([uploadedAt])
  @@index([projectId])
}

// ============================================================================
// SITE REPORT (Şantiye Günlüğü)
// ============================================================================

model SiteReport {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  weather     String? // Örn: Güneşli, Yağmurlu 30°C
  workerCount Int      @default(0)
  notes       String   @db.Text
  images      String? // Virgülle ayrılmış resim URL'leri veya JSON

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdBy String? // Raporu yazan kişi
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([date])
}

// ============================================================================
// EQUIPMENT (Demirbaş Takibi - BLE Hazırlığı)
// ============================================================================

model Equipment {
  id              String    @id @default(cuid())
  name            String
  type            String // ARAC, IS_MAKINESI, ELEKTRONIK, DIGER
  category        String? // Kategori
  status          String    @default("AVAILABLE") // AVAILABLE, ASSIGNED, MAINTENANCE
  serialNumber    String?   @unique // BLE MAC adresi veya Seri No (zorunlu)
  plateOrSerialNo String? // @deprecated - Use serialNumber instead
  bleTagId        String?   @unique
  latitude        Float?
  longitude       Float?
  lastSeenAt      DateTime?
  nextMaintenance DateTime?

  assignedToId String? // Kime zimmetli
  assignedTo   Personel? @relation(fields: [assignedToId], references: [id])

  lastLat Float? // Son BLE konumu (Enlem)
  lastLng Float? // Son BLE konumu (Boylam)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([serialNumber])
  @@index([bleTagId])
  @@index([tenantId])
}

// ============================================================================
// LOCATION LOG (Konum Geçmişi)
// ============================================================================

model LocationLog {
  id        String   @id @default(cuid())
  userId    String
  latitude  Float
  longitude Float
  accuracy  Float?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}

// ============================================================================
// DRONE MEDIA (Drone Çekim Arşivi)
// ============================================================================

model DroneMedia {
  id          String   @id @default(cuid())
  title       String // Örn: "A Blok Temel Atımı"
  url         String // Cloudinary veya AWS S3 linki
  mediaType   String // "IMAGE" veya "VIDEO"
  date        DateTime // Çekim tarihi
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  description String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([tenantId])
  @@index([date])
  @@index([mediaType])
}

// ============================================================================
// CHAT THREAD (Konu Bazlı Odalar)
// ============================================================================

model ChatThread {
  id           String            @id @default(cuid())
  title        String // Örn: "B Blok 3. Kat Kolon Çatlağı"
  status       String            @default("OPEN") // OPEN, RESOLVED, ARCHIVED
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  tenantId     String?
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     ThreadMessage[]
  participants ChatParticipant[]

  @@index([projectId])
  @@index([tenantId])
  @@index([status])
  @@index([createdById])
}

model ThreadMessage {
  id         String     @id @default(cuid())
  content    String
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String // Gönderenin Personel ID'si veya Admin User ID'si
  senderName String // UI'da kolay göstermek için
  createdAt  DateTime   @default(now())

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

model ChatParticipant {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  personelId String
  personel   Personel   @relation(fields: [personelId], references: [id])

  @@index([threadId])
  @@index([personelId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  severity  String   @default("INFO") // INFO, WARNING, URGENT
  projectId String? // Null ise tüm projelere (şirket geneli)
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([severity])
  @@index([createdAt])
}

// ============================================================================
// COMPANY (Firma Yönetimi)
// ============================================================================

model Company {
  id                     String                  @id @default(cuid())
  name                   String
  type                   CompanyType             @default(MAIN_CONTRACTOR)
  contactName            String?
  phone                  String?
  email                  String?
  taxNumber              String?
  taxOffice              String?
  organizationId         String?
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  personnel              Personel[]
  users                  User[]
  contracts              Contract[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  projects               Project[]
  yibfProjects           YibfProject[]
  transactions           Transaction[]
  audits                 Audit[]
  dailyProgress          DailyProgress[]
  subcontractorContracts SubcontractorContract[]
  workerDocuments        WorkerDocument[]
  eInvoices              EInvoice[]
  subcontractorScore     SubcontractorScore?
  financialDocuments     FinancialDocument[]
  supplierBids           SupplierBid[]

  @@index([type])
  @@index([organizationId])
}

// ============================================================================
// CARİ (Tedarikçi) YÖNETİMİ
// ============================================================================

model Cari {
  id          String    @id @default(cuid())
  code        String    @unique // Cari kodu (C001, C002, vb.)
  name        String // Firma/Şahıs adı
  type        CariType  @default(SUPPLIER) // Tedarikçi/Müşteri
  contactName String? // İletişim kişisi
  email       String?
  phone       String?
  address     String?   @db.Text
  taxNumber   String? // Vergi numarası
  taxOffice   String? // Vergi dairesi
  balance     Float     @default(0) // Mevcut bakiye
  debts       Debt[]
  payments    Payment[]
  notes       String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([type])
  @@index([isActive])
}

enum CariType {
  SUPPLIER
  CUSTOMER
}

model Debt {
  id          String    @id @default(cuid())
  cariId      String
  cari        Cari      @relation(fields: [cariId], references: [id], onDelete: Cascade)
  amount      Float
  description String?   @db.Text
  dueDate     DateTime? // Vade tarihi
  isPaid      Boolean   @default(false)
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([cariId])
  @@index([isPaid])
  @@index([dueDate])
}

model Payment {
  id            String   @id @default(cuid())
  cariId        String
  cari          Cari     @relation(fields: [cariId], references: [id], onDelete: Cascade)
  amount        Float
  description   String?  @db.Text
  paymentMethod String? // Nakit, Havale, Kredi Kartı, vb.
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([cariId])
  @@index([date])
}

// ============================================================================
// STOK YÖNETİMİ
// ============================================================================

model Stock {
  id             String             @id @default(cuid())
  code           String             @unique // Stok kodu (S001, S002, vb.)
  name           String // Stok adı
  category       String? // Kategori
  unit           StockUnit // Birim
  quantity       Float              @default(0)
  minStock       Float? // Minimum stok seviyesi
  maxStock       Float? // Maksimum stok seviyesi
  costPrice      Float? // Birim maliyet
  sellPrice      Float? // Satış fiyatı
  isActive       Boolean            @default(true)
  materialId     String?
  material       Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  transactions   StockTransaction[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([code])
  @@index([category])
  @@index([isActive])
  @@index([materialId])
}

enum StockUnit {
  ADET
  KG
  TON
  M
  M2
  M3
  LT
  PAKET
  KUTU
  DEMET
}

model StockTransaction {
  id          String          @id @default(cuid())
  stockId     String
  stock       Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)
  type        TransactionType
  quantity    Float
  unitPrice   Float? // Birim fiyat
  totalPrice  Float? // Toplam tutar
  description String?         @db.Text
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([stockId])
  @@index([type])
  @@index([date])
}

enum TransactionType {
  IN
  OUT
}

model StockMovement {
  id          String   @id @default(cuid())
  type        String // GIRIS veya CIKIS
  quantity    Float
  description String?
  date        DateTime @default(now())

  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  personnelId String?
  personel    Personel? @relation(fields: [personnelId], references: [id])

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockId])
  @@index([date])
  @@index([projectId])
  @@index([personnelId])
  @@index([purchaseOrderId])
  @@index([workPackageId])
  @@index([materialId])
}

// ============================================================================
// PERSONNEL PROFESSION/UNIT (Meslek/Birim Yönetimi)
// ============================================================================

model Profession {
  id        String   @id @default(cuid())
  name      String   @unique // Örn: "Kalıpçı", "Elektrikçi", "Demirci", "Şoför"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personel Personel[]
  tasks    Task[]

  @@index([name])
}

// ============================================================================
// PERSONEL YÖNETİMİ
// ============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  WORKER
  OFFICER
  PARTNERSHIP
  CONTRACTOR
}

enum PersonelStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  RETIRED
}

model Personel {
  id                       String                    @id @default(cuid())
  personnelNo              String                    @unique // Personel no (P001, P002, vb.)
  name                     String // Ad Soyad
  tcNo                     String?                   @unique // TC Kimlik No
  sgkNo                    String? // SGK No
  age                      Int
  birthDate                DateTime
  gender                   Gender?
  phone                    String?
  email                    String?
  address                  String?                   @db.Text
  department               String // Çalışılan birim
  position                 String? // Görev/Ünvan
  currentSite              String // Mevcut şantiye lokasyonu
  hireDate                 DateTime // İşe giriş tarihi
  leavingDate              DateTime? // İşten çıkış tarihi
  employmentType           EmploymentType? // İşçi/Memur/Şirket Ortaklığı
  status                   PersonelStatus            @default(ACTIVE)
  salary                   Float                     @default(0)
  salaryStatus             String                    @default("Pending") // Paid, Pending
  salaryPayDay             Int?
  sgkPeriod                String?
  sgkPayDay                Int?
  healthStatus             String?
  bloodType                String? // Kan grubu
  bonuses                  Float                     @default(0)
  takim                    String? // Takım (Demirci, Kalıpçı vb.) - DEPRECATED, use professionId
  gunlukYevmiye            Float                     @default(0) // Günlük Yevmiye
  userId                   String? // AdminUser ile eşleşme (opsiyonel)
  username                 String? // Kullanıcı adı (login için)
  role                     UserRole                  @default(STAFF) // Rol bazlı yetkilendirme
  companyId                String? // Firma ID (Taşeron izolasyonu için)
  company                  Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tenantId                 String? // Tenant ID (SaaS multi-tenancy)
  tenant                   Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  emergencyContactName     String? // Acil durum kişisi adı
  emergencyContactPhone    String? // Acil durum kişisi telefon
  emergencyContactRelation String? // Acil durum kişisi yakınlık
  nfcUid                   String?                   @unique // NFC Kart UID (Gelecekteki mobil NFC entegrasyonu için)
  bankName                 String? // Banka Adı
  iban                     String? // IBAN
  professionId             String? // Meslek/Birim ID
  profession               Profession?               @relation(fields: [professionId], references: [id], onDelete: SetNull)
  siteHistory              SiteHistory[]
  payments                 PersonelPayment[]
  insurance                Insurance?
  inventoryHistory         InventoryHistory[]
  inventoryAssignments     InventoryAssignment[]
  transactions             Transaction[]
  movements                StockMovement[]
  attendanceRecords        AttendanceRecord[]
  contracts                PersonnelContract[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("PersonelSender")
  isgReports               IsgReport[]
  certificates             Certificate[]
  ppeDeliveries            PPEDelivery[]
  leaveRequests            LeaveRequest[]
  assignedTasks            WorkOrder[]               @relation("PersonelTasks")
  assignedEquipment        Equipment[]
  chatParticipants         ChatParticipant[]
  materialRequests         MaterialRequest[]
  assignedProjectTasks     ProjectTask[]             @relation("AssignedTasks")
  inspectionRecords        InspectionRecord[]
  deficiencies             Deficiency[]
  assignedInspectionTasks  InspectionTask[]
  notes                    String?                   @db.Text
  audits                   Audit[]
  inspections              Inspection[]
  reportedDeficiencies     Deficiency[]              @relation("DeficiencyReporter")
  rebarFormworkChecks      RebarFormworkCheck[]
  materialApprovals        MaterialApproval[]
  reportedNonconformities  NonconformityDOF[]        @relation("NonconformityReporter")
  reportedNearMisses       NearMiss[]                @relation("NearMissReporter")
  ppeAssignments           PPEAssignment[]
  legalCertificates        LegalCertificate[]
  auditRecords             AuditRecord[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([personnelNo])
  @@index([department])
  @@index([currentSite])
  @@index([status])
  @@index([takim])
  @@index([userId])
  @@index([professionId])
  @@index([role])
  @@index([companyId])
}

// ============================================================================
// AUDIT (Taşeron Denetim ve Performans)
// ============================================================================

model Audit {
  id     String  @id @default(cuid())
  title  String // Örn: "A Blok 3. Kat Kalıp Denetimi"
  type   String // OHS (İSG), QUALITY (Kalite), PROGRESS (İlerleme)
  score  Int // 0-100 arası puan
  status String // PASSED, FAILED, ACTION_REQUIRED
  notes  String? @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  subcontractorId String
  subcontractor   Company @relation(fields: [subcontractorId], references: [id])

  inspectorId String
  inspector   Personel @relation(fields: [inspectorId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([subcontractorId])
  @@index([inspectorId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// DAILY PROGRESS (Günlük İlerleme Raporları)
// ============================================================================

model DailyProgress {
  id                   String   @id @default(cuid())
  description          String   @db.Text
  completionPercentage Int // 0-100
  photos               String[] // Fotoğraf URL'leri

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  subcontractorId String
  subcontractor   Company @relation(fields: [subcontractorId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([subcontractorId])
  @@index([createdAt])
}

// ============================================================================
// BIM ISSUE (3D Kusur İşaretleme - Snagging)
// ============================================================================

model BimIssue {
  id          String  @id @default(cuid())
  title       String
  description String  @db.Text
  imageUrl    String?
  positionX   Float
  positionY   Float
  positionZ   Float
  status      String // OPEN, RESOLVED

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  subcontractorName String?
  subcontractorId   String?
  subcontractor     Subcontractor?   @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  workPackageId     String?
  workPackage       WorkPackage?     @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  progressPaymentId String?
  progressPayment   ProgressPayment? @relation(fields: [progressPaymentId], references: [id], onDelete: SetNull)
  blockPayment      Boolean?         @default(false)
  penaltyAmount     Float?
  severity          String?          @default("NORMAL")

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([status])
  @@index([subcontractorId])
  @@index([workPackageId])
  @@index([progressPaymentId])
  @@index([createdAt])
}

// ============================================================================
// BIM FILE ARCHIVE (Kalıcı 3D BIM Model Arşivi)
// ============================================================================

model BimFile {
  id         String             @id @default(cuid())
  projectId  String
  fileName   String // Örn: "A-Blok-Statik.ifc"
  fileUrl    String // UploadThing'den gelen URL
  fileType   String? // ifc, gltf, glb vb.
  uploadedAt DateTime           @default(now())
  isActive   Boolean            @default(false) // Seçili (Ekranda açık olan) model mi?
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions  DocumentRevision[]

  @@index([projectId])
  @@index([isActive])
}

// ============================================================================
// PROGRESS BILLING (Hakediş - Taşeron Ödemesi)
// ============================================================================

model ProgressBilling {
  id                 String        @id @default(cuid())
  contractId         String?
  billingNumber      Int           @default(0)
  period             DateTime      @default(now())
  grossAmount        Float         @default(0)
  advanceDeduction   Float         @default(0)
  penaltyDeduction   Float         @default(0)
  retentionDeduction Float         @default(0)
  netPayable         Float         @default(0)
  status             BillingStatus @default(DRAFT)

  contract              Contract?              @relation(fields: [contractId], references: [id])
  financialTransactions FinancialTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([status])
  @@index([period])
}

// ============================================================================
// SUBCONTRACTOR (Taşeron Yönetimi - Hakediş Modülü İçin)
// ============================================================================

model Subcontractor {
  id                    String                 @id @default(cuid())
  name                  String
  taxNumber             String?
  contactName           String?
  phone                 String?
  organizationId        String?
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deductions            Deduction[]            @relation("DeductionSubcontractor")
  workProofs            WorkProof[]
  bimIssues             BimIssue[]
  progressPayments      ProgressPayment[]
  financialTransactions FinancialTransaction[]
  createdAt             DateTime               @default(now())

  @@index([organizationId])
}

// ============================================================================
// CONTRACT (Taşeron Sözleşmeleri - Hakediş Modülü İçin)
// ============================================================================

model Contract {
  id              String         @id @default(cuid())
  projectId       String
  subcontractorId String
  title           String
  totalAmount     Float
  startDate       DateTime
  endDate         DateTime
  status          ContractStatus @default(ACTIVE)

  project               Project                @relation(fields: [projectId], references: [id])
  subcontractor         Company                @relation(fields: [subcontractorId], references: [id])
  billings              ProgressBilling[]
  workProofs            WorkProof[]
  payments              ProgressPayment[]
  financialTransactions FinancialTransaction[]
  transactions          Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([subcontractorId])
  @@index([status])
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum BillingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

// ============================================================================
// SUBCONTRACTOR CONTRACT (Taşeron Sözleşmeleri)
// ============================================================================

model SubcontractorContract {
  id           String    @id @default(cuid())
  contractType String // UNIT_PRICE, LUMP_SUM
  totalValue   Float
  startDate    DateTime
  endDate      DateTime?
  status       String // DRAFT, ACTIVE, COMPLETED, CANCELLED
  notes        String?   @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  subcontractorId String
  subcontractor   Company @relation(fields: [subcontractorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([subcontractorId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// WORKER DOCUMENT (İSG ve SGK Evrak Takibi)
// ============================================================================

model WorkerDocument {
  id            String  @id @default(cuid())
  workerName    String
  tcNo          String? // TC Kimlik No
  sgkStatus     Boolean @default(false) // SGK kaydı var mı?
  ohsTraining   Boolean @default(false) // İSG eğitimi alındı mı?
  medicalReport Boolean @default(false) // Sağlık raporu var mı?
  notes         String? @db.Text

  subcontractorId String
  subcontractor   Company @relation(fields: [subcontractorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subcontractorId])
  @@index([createdAt])
}

// ============================================================================
// DEDUCTION (Kesintiler ve Cezalar)
// ============================================================================

model Deduction {
  id                 String   @id @default(cuid())
  amount             Float
  reason             String   @db.Text
  date               DateTime @default(now())
  appliedToBillingId String? // Hangi hakedişe uygulandı?
  notes              String?  @db.Text

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  subcontractorId String
  subcontractor   Subcontractor @relation("DeductionSubcontractor", fields: [subcontractorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([subcontractorId])
  @@index([appliedToBillingId])
  @@index([date])
  @@index([createdAt])
}

// ============================================================================
// MATERIAL REQUEST (Malzeme Talebi)
// ============================================================================

model MaterialRequest {
  id       String  @id @default(cuid())
  itemName String
  quantity Int
  unit     String // kg, adet, m, m2, vb.
  urgency  String // LOW, NORMAL, HIGH, CRITICAL
  status   String // PENDING, QUOTING, APPROVED, REJECTED, DELIVERED
  notes    String? @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  requesterId String
  requester   Personel @relation(fields: [requesterId], references: [id])

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([requesterId])
  @@index([status])
  @@index([urgency])
  @@index([createdAt])
}

// ============================================================================
// PURCHASE ORDER (Satınalma Siparişi)
// ============================================================================

model PurchaseOrder {
  id               String    @id @default(cuid())
  supplierName     String
  unitPrice        Float
  totalPrice       Float
  orderDate        DateTime  @default(now())
  status           String    @default("PENDING") // PENDING, APPROVED, DELIVERED, CANCELLED
  receivedQuantity Float?
  deliveredAt      DateTime?

  requestId String
  request   MaterialRequest @relation(fields: [requestId], references: [id])

  approvedById String?
  approvedBy   User?   @relation(fields: [approvedById], references: [id])

  stockId String?
  stock   Stock?  @relation(fields: [stockId], references: [id], onDelete: SetNull)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  stockMovements    StockMovement[]
  approvalWorkflows ApprovalWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([approvedById])
  @@index([orderDate])
  @@index([status])
  @@index([stockId])
  @@index([materialId])
  @@index([createdAt])
}

// ============================================================================
// SHIFT (Vardiya Planlaması)
// ============================================================================

model Shift {
  id             String   @id @default(cuid())
  name           String // Örn: "Sabah Vardiyası", "Gece Vardiyası"
  timeRange      String // Örn: "08:00 - 17:00"
  personnelCount Int      @default(0)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status         String   @default("Active") // Active, Inactive
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ============================================================================
// PROJECT TASK (İş Programı - Gantt Şeması Görevleri)
// ============================================================================

model ProjectTask {
  id           String   @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  progress     Int      @default(0) // 0-100 arası ilerleme yüzdesi
  dependencies String? // Kendinden önce bitmesi gereken task'ın ID'si (virgülle ayrılmış)
  notes        String?  @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  assignedToId String?
  assignedTo   Personel? @relation("AssignedTasks", fields: [assignedToId], references: [id])

  workPackageId String?
  workPackage   WorkPackage? @relation("WorkPackageTasks", fields: [workPackageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assignedToId])
  @@index([workPackageId])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
}

// ============================================================================
// PROJECT DOCUMENT (Doküman ve Revizyon Yönetimi)
// ============================================================================

model ProjectDocument {
  id              String  @id @default(cuid())
  title           String
  type            String // BLUEPRINT, SPECIFICATION, CONTRACT, OTHER
  fileUrl         String
  revision        Int     @default(0)
  status          String  @default("ACTIVE") // ACTIVE, OBSOLETE
  documentGroupId String? // Aynı dosyanın yeni revizyonları aynı groupId'ye sahip

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  revisions DocumentRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([uploadedById])
  @@index([documentGroupId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// YİBF PROJECT (Yapı İzleme Belgesi - Yapı Denetim Binaları)
// ============================================================================

model YibfProject {
  id             String @id @default(cuid())
  yibfNo         String @unique
  address        String
  ownerName      String
  contractorName String
  totalArea      Float
  floors         Int
  status         String @default("ACTIVE") // ACTIVE, COMPLETED, SUSPENDED

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  inspectionRecords InspectionRecord[]
  deficiencies      Deficiency[]
  yibfEvents        YibfEvent[]
  inspectionTasks   InspectionTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([yibfNo])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// INSPECTION RECORD (Kanıt Zinciri - Yapı Denetim Kayıtları)
// ============================================================================

model InspectionRecord {
  id        String   @id @default(cuid())
  category  String // Örn: Demir, Beton, Duvar, Tesisat
  status    String   @default("PENDING") // PASS, FAIL, PENDING
  gpsLat    Float?
  gpsLng    Float?
  timestamp DateTime @default(now())
  hash      String? // Değiştirilemez kayıt için
  notes     String?  @db.Text

  yibfId String
  yibf   YibfProject @relation(fields: [yibfId], references: [id])

  inspectorId String
  inspector   Personel @relation(fields: [inspectorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yibfId])
  @@index([inspectorId])
  @@index([status])
  @@index([category])
  @@index([timestamp])
}

// ============================================================================
// DEFICIENCY (Uygunsuzluk/Eksiklik)
// ============================================================================

model Deficiency {
  id          String    @id @default(cuid())
  floor       String // Kat
  element     String // Örn: Kolon C12
  category    String // Örn: Donatı, Beton, Duvar
  priority    String    @default("MEDIUM") // LOW, MEDIUM, CRITICAL
  description String    @db.Text
  photoUrl    String?
  status      String    @default("OPEN") // OPEN, FIX_PENDING, VERIFY_PENDING, CLOSED
  dueDate     DateTime?
  closedAt    DateTime?

  yibfId String?
  yibf   YibfProject? @relation(fields: [yibfId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  inspectorId String?
  inspector   Personel? @relation(fields: [inspectorId], references: [id], onDelete: SetNull)

  reporterId String?
  reporter   Personel? @relation("DeficiencyReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  severity      String     @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  location      String? // Örn: "A Blok - Zemin Kat - Kolon K3"
  evidenceChain String?    @db.Text // JSON formatında kanıt zinciri verisi
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yibfId])
  @@index([projectId])
  @@index([inspectorId])
  @@index([reporterId])
  @@index([inspectionId])
  @@index([status])
  @@index([priority])
  @@index([severity])
  @@index([dueDate])
  @@index([createdAt])
}

// ============================================================================
// YİBF EVENT (Zaman Makinesi Logları)
// ============================================================================

model YibfEvent {
  id          String   @id @default(cuid())
  eventType   String // Örn: "Ruhsat Alındı", "Eksiklik Açıldı", "Beton Döküldü"
  description String?  @db.Text
  timestamp   DateTime @default(now())

  yibfId String
  yibf   YibfProject @relation(fields: [yibfId], references: [id])

  userId String?

  createdAt DateTime @default(now())

  @@index([yibfId])
  @@index([eventType])
  @@index([timestamp])
  @@index([createdAt])
}

// ============================================================================
// INSPECTION TASK (Görev Dağıtımı)
// ============================================================================

model InspectionTask {
  id     String      @id @default(cuid())
  yibfId String
  yibf   YibfProject @relation(fields: [yibfId], references: [id])

  assignedToId String
  assignedTo   Personel @relation(fields: [assignedToId], references: [id])

  taskDate   DateTime
  taskType   String // Örn: "Beton", "Donatı", "Kalıp"
  status     String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  orderIndex Int      @default(0) // Rota sırası

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yibfId])
  @@index([assignedToId])
  @@index([taskDate])
  @@index([status])
  @@index([orderIndex])
}

// ============================================================================
// NOTIFICATIONS (Bildirimler)
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, ERROR, SUCCESS, URGENT
  isRead    Boolean  @default(false)
  link      String? // Tıklayınca yönlendirme linki
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// WORK ORDERS (İş Emirleri)
// ============================================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Department {
  MIMARI
  MEKANIK
  ELEKTRIK
  INSAAT
  GENEL
}

// ============================================================================
// LEAVE REQUEST (İzin Talepleri)
// ============================================================================

model LeaveRequest {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  personelId  String?
  personel    Personel?   @relation(fields: [personelId], references: [id], onDelete: Cascade)
  leaveType   String?     // "YILLIK", "MAZERET", "RAPORLU", "UCRETSIZ"
  type        LeaveType?  @default(ANNUAL)
  startDate   DateTime
  endDate     DateTime
  totalDays   Int?        // Sadece iş günleri (Hafta sonları ve resmi tatiller hariç hesaplanmalı)
  days        Int?        // İzin gün sayısı
  reason      String?     @db.Text
  status      String      @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy  String?     // Onaylayan kişi ID
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([personelId])
  @@index([status])
  @@index([startDate])
}

enum LeaveType {
  ANNUAL // Yıllık İzin
  EXCUSE // Mazeret İzni
  SICK // Hastalık İzni
  UNPAID // Ücretsiz İzin
}

enum LeaveStatus {
  PENDING // Bekliyor
  APPROVED // Onaylandı
  REJECTED // Reddedildi
}

model SiteHistory {
  id         String    @id @default(cuid())
  personelId String
  personel   Personel  @relation(fields: [personelId], references: [id], onDelete: Cascade)
  siteName   String
  siteCode   String? // Şantiye kodu
  startDate  DateTime
  endDate    DateTime?
  position   String? // Şantiyedeki görev
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())

  @@index([personelId])
  @@index([siteName])
  @@index([startDate])
}

model PersonelPayment {
  id          String        @id @default(cuid())
  personelId  String
  personel    Personel      @relation(fields: [personelId], references: [id], onDelete: Cascade)
  type        String // MAAS, SGK, PRIM, AVANS, ELDEN, SALARY, BONUS, etc.
  amount      Float
  description String?       @db.Text
  period      String? // Dönem (Ocak 2024, vb.)
  isPaid      Boolean       @default(false)
  paidDate    DateTime?
  status      PaymentStatus @default(PENDING) // PENDING, APPROVED, REJECTED (özellikle avans için)
  date        DateTime      @default(now()) // Ödeme/kesinti tarihi
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([personelId])
  @@index([type])
  @@index([isPaid])
  @@index([period])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  SALARY
  BONUS
  ROTATING_CAPITAL
  DEDUCTION
  OVERTIME
  MAAS
  SGK
  PRIM
  AVANS
  ELDEN
}

