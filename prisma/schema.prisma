  description      String?
  quantity         Float // Örn: 150 (Metraj)
  unit             String // Örn: "m2", "m3", "Adet"
  unitPrice        Float? // Birim Fiyat (Örn: 120 TL)
  totalPrice       Float? // quantity * unitPrice
  amount           Float?   @default(0) // Toplam Tutar
  status           String   @default("BEKLIYOR") // BEKLIYOR, ONAYLANDI, ODENDI, PENDING, APPROVED, BLOCKED
  date             DateTime @default(now())
  penaltyDeduction Float?   @default(0) // Ceza / Kusur kesintileri
  netAmount        Float?   @default(0) // Net ödenecek tutar
  retentionRate    Float?   @default(0.05) // %5 Teminat (Geçici Kabul) Kesintisi Oranı
  retentionAmount  Float?   // Kesilen Teminat Tutarı
  advanceDeduction Float?   // Varsa Taşerona verilen avansın mahsubu
  netPayableAmount Float?   // Ödenecek Net Tutar (Toplam - Kusur Cezaları - Teminat - Avans)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)

  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)

  boqItemId String?
  boqItem   BoQItem? @relation(fields: [boqItemId], references: [id], onDelete: SetNull)

  // Hakedişi bloke eden kusurların listesi:
  blockingIssues BimIssue[]

  financialTransactions FinancialTransaction[]
  transactions          Transaction[]
  approvalWorkflows     ApprovalWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([date])
  @@index([projectId])
  @@index([contractId])
  @@index([subcontractorId])
  @@index([workPackageId])
  @@index([boqItemId])
}

