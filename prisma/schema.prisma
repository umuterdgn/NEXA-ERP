  personelId     String?
  personel       Personel?    @relation(fields: [personelId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@unique([conversationId, personelId])
  @@index([conversationId])
  @@index([userId])
  @@index([personelId])
}

