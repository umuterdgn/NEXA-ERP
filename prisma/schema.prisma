  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([personelId])
  @@index([projectId])
  @@index([status])
  @@index([type])
}

enum IsgReportType {
  TEHLIKE
  KAZA_TUTANAGI
  EKSIK_DOKUM
}

enum IsgReportStatus {
  ACIL
  INCELEMEDE
  COZULDU
}

