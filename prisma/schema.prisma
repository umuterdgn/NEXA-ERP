  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Department {
  MIMARI
  MEKANIK
  ELEKTRIK
  INSAAT
  GENEL
}

// ============================================================================
// LEAVE REQUEST (İzin Talepleri)
// ============================================================================

model LeaveRequest {
  id          String       @id @default(cuid())
  personelId  String
  personel    Personel     @relation(fields: [personelId], references: [id], onDelete: Cascade)
  type        LeaveType    @default(ANNUAL)
  startDate   DateTime
  endDate     DateTime
  days        Int          // İzin gün sayısı
