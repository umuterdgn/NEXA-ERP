  status      LeaveStatus  @default(PENDING)
  reviewedBy  String?      // Onaylayan kişi ID
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([personelId])
  @@index([status])
  @@index([startDate])
}

enum LeaveType {
  ANNUAL      // Yıllık İzin
  EXCUSE      // Mazeret İzni
  SICK        // Hastalık İzni
  UNPAID      // Ücretsiz İzin
}

enum LeaveStatus {
  PENDING     // Bekliyor
  APPROVED    // Onaylandı
  REJECTED    // Reddedildi
}

model SiteHistory {
  id          String   @id @default(cuid())
  personelId  String
  personel    Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)
  siteName    String
  siteCode    String?  // Şantiye kodu
  startDate   DateTime
  endDate     DateTime?
  position    String?  // Şantiyedeki görev
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([personelId])
  @@index([siteName])
  @@index([startDate])
}

model PersonelPayment {
  id          String          @id @default(cuid())
  personelId  String
  personel    Personel        @relation(fields: [personelId], references: [id], onDelete: Cascade)
  type        String          // MAAS, SGK, PRIM, AVANS, ELDEN, SALARY, BONUS, etc.
  amount      Float
  description String?         @db.Text
  period      String?         // Dönem (Ocak 2024, vb.)
  isPaid      Boolean         @default(false)
  paidDate    DateTime?
  status      PaymentStatus   @default(PENDING) // PENDING, APPROVED, REJECTED (özellikle avans için)
  date        DateTime        @default(now()) // Ödeme/kesinti tarihi
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([personelId])
  @@index([type])
  @@index([isPaid])
  @@index([period])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}



enum PaymentType {
  SALARY
  BONUS
  ROTATING_CAPITAL
  DEDUCTION
  OVERTIME
  MAAS
  SGK
  PRIM
  AVANS
  ELDEN
}

// ============================================================================
// CERTIFICATE (Sertifikalar ve Belgeler)
// ============================================================================

model Certificate {
  id          String   @id @default(cuid())
  personelId  String
  personel    Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)
  name        String   // Sertifika/Belge adı
  expiryDate  DateTime // Bitiş tarihi
  documentUrl String?  // Belge URL (Cloudinary/AWS)
  type        String   @default("SERTIFIKA") // SERTIFIKA, BELGE, LISANS, DİĞER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([personelId])
  @@index([expiryDate])
  @@index([type])
}

model Insurance {
  id                  String   @id @default(cuid())
  personelId          String   @unique
  personel            Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)
  insuranceNo         String?  // Sigorta poliçe no
  insuranceCompany    String?  // Sigorta şirketi
  startDate           DateTime
  renewalPeriod       Int      // Yenileme periyodu (ay)
  nextRenewalDate     DateTime
  premiumAmount       Float?   // Prim tutarı
  status              InsuranceStatus @default(ACTIVE)
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([personelId])
  @@index([nextRenewalDate])
  @@index([status])
}

enum InsuranceStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

// ============================================================================
// SYSTEM SETTINGS
// ============================================================================

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique // Setting key (e.g., "drive_folder_id")
  value     String   // Setting value
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// FINANCE TRANSACTIONS
// ============================================================================

model Transaction {
  id          String   @id @default(cuid())
  type        String   // GELIR veya GIDER
  amount      Float
  description String
  date        DateTime @default(now())
  category    String   // MAAS, SGK, HAKEDIS, MALZEME, DEMIR, BETON, NAKIYE, YEMEK, TASERON, PRIM, AVANS, ELDEN, DIGER

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  
  personnelId String?
  personnel   Personel? @relation(fields: [personnelId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([date])
  @@index([category])
  @@index([projectId])
  @@index([companyId])
  @@index([personnelId])
