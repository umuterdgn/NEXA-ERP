// ============================================================================
// İLETİŞİM & OPERASYONEL OTOMASYON
// ============================================================================

model ChatMessage {
  id              String   @id @default(cuid())
  senderId        String   // Gönderen Personel ID
  receiverId      String?  // Alıcı Personel ID (Birebir mesajsa)
  channelName     String?  // Grup mesajıysa (Örn: "Şantiye Şefleri", "İSG Acil Durum")
  content         String   @db.Text
  
  // Referans Mantığı (Veritabanını şişirmemek için)
