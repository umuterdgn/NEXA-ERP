// ============================================================================
// CHAT (Mesajlaşma Sistemi)
// ============================================================================

model Conversation {
  id             String   @id @default(cuid())
  name           String?  // Grup adı (opsiyonel)
  isGroup        Boolean  @default(false)
  isAnnouncement Boolean  @default(false)
  createdAt      DateTime @default(now())

  messages      Message[]
  participants  ConversationParticipant[]
}

model Message {
  id             String       @id @default(cuid())
  body           String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  personelSenderId String?
  personelSender   Personel?    @relation("PersonelSender", fields: [personelSenderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([personelSenderId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  personelId     String?
  personel       Personel?    @relation(fields: [personelId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@unique([conversationId, personelId])
  @@index([conversationId])
  @@index([userId])
  @@index([personelId])
}

// ============================================================================
// İSG (İş Sağlığı ve Güvenliği) BİLDİRİMLERİ
// ============================================================================

model IsgReport {
  id          String   @id @default(cuid())
  type        IsgReportType @default(TEHLIKE) // TEHLIKE, KAZA_TUTANAGI, EKSIK_DOKUM
  status      IsgReportStatus @default(ACIL) // ACIL, INCELEMEDE, COZULDU
  description String   @db.Text
  imageUrl    String?  // Saha fotoğrafı
