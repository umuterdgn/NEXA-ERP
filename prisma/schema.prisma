  reportedBy   Personel @relation("NonconformityReporter", fields: [reportedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([reportedById])
}

// ============================================================================
// LEGAL CERTIFICATE (Yasal Evrak ve Sertifika Takibi)
