  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([yibfNo])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// INSPECTION RECORD (Kanıt Zinciri - Yapı Denetim Kayıtları)
// ============================================================================

model InspectionRecord {
  id           String   @id @default(cuid())
  category     String   // Örn: Demir, Beton, Duvar, Tesisat
  status       String   @default("PENDING") // PASS, FAIL, PENDING
  gpsLat       Float?
  gpsLng       Float?
