  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([uploadedById])
  @@index([documentGroupId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// YİBF PROJECT (Yapı İzleme Belgesi - Yapı Denetim Binaları)
// ============================================================================

model YibfProject {
  id             String   @id @default(cuid())
  yibfNo         String   @unique
  address        String
  ownerName      String
  contractorName String
  totalArea      Float
  floors         Int
  status         String   @default("ACTIVE") // ACTIVE, COMPLETED, SUSPENDED
  
