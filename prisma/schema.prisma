// ============================================================================
// INVENTORY (Stok & QR)
// ============================================================================

model InventoryHistory {
  id          String   @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  action      String   // "CREATED", "STOCK_ADDED", "STOCK_REMOVED", "ASSIGNED", "UNASSIGNED", "TRANSFERRED"
  quantity    Float?
  description String?  @db.Text
  personnelId  String?  // If assigned/unassigned
  personnel   Personel? @relation(fields: [personnelId], references: [id], onDelete: SetNull)
  userId      String?  // Who performed the action
  createdAt   DateTime @default(now())

  @@index([inventoryId])
  @@index([action])
  @@index([createdAt])
  @@index([personnelId])
}

model InventoryAssignment {
  id          String              @id @default(cuid())
  inventoryId String
  inventory   Inventory           @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  personelId  String?
  personel    Personel?           @relation(fields: [personelId], references: [id], onDelete: SetNull)
  quantity    Int                 // Zimmetlenen miktar
  assignedAt  DateTime            @default(now())
  returnedAt  DateTime?           // Teslim edildiğinde dolacak
  status      AssignmentStatus    @default(ACTIVE) // ACTIVE, MAINTENANCE, RETURNED, LOST
  condition   String?             // İyi, Orta, Kötü, Arızalı
  notes       String?             @db.Text

  @@index([inventoryId])
  @@index([personelId])
  @@index([assignedAt])
  @@index([returnedAt])
  @@index([status])
}

enum AssignmentStatus {
  ACTIVE
  MAINTENANCE
  RETURNED
  LOST
}


model Inventory {
  id          String   @id @default(cuid())
  name        String
  type        String   // IN veya OUT
  quantity    Float
  unit        String
  category    String?  // Kategori
  location    String?  // Konum/Depo
  qrCode      String?  @unique // QR kod (opsiyonel ama unique)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy  String
  recorder    User     @relation(fields: [recordedBy], references: [id])
  assignments InventoryAssignment[]
  createdAt   DateTime @default(now())
  history     InventoryHistory[]

  @@index([projectId])
  @@index([type])
  @@index([qrCode])
}

