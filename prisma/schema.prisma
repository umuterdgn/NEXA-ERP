  title         String
  type          String // ISG_CERTIFICATE, PROFESSIONAL_LICENSE, OTHER
  certificateNo String
  issueDate     DateTime
  expiryDate    DateTime
  status        String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  fileUrl       String?
  notes         String?  @db.Text

  personelId String
  personel   Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personelId])
  @@index([type])
  @@index([status])
  @@index([expiryDate])
}

// ============================================================================
// NEAR MISS (Ramak Kala Bildirim)
// ============================================================================

model NearMiss {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  severity     String   @default("LOW") // LOW, MEDIUM, HIGH
  status       String   @default("OPEN") // OPEN, INVESTIGATING, CLOSED
  incidentDate DateTime
  location     String?
  imageUrl     String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reportedById String
  reportedBy   Personel @relation("NearMissReporter", fields: [reportedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([severity])
  @@index([status])
  @@index([incidentDate])
  @@index([reportedById])
}

// ============================================================================
// PPE ASSIGNMENT (KKD Dijital Zimmet)
// ============================================================================

model PPEAssignment {
  id             String    @id @default(cuid())
  itemName       String
  type           String // HELMET, VEST, BOOTS, GLOVES, OTHER
  serialNo       String?
  status         String    @default("ASSIGNED") // ASSIGNED, RETURNED, DAMAGED, LOST
  assignmentDate DateTime
  returnDate     DateTime?
  notes          String?   @db.Text

  personelId String
  personel   Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personelId])
  @@index([type])
  @@index([status])
  @@index([projectId])
}

// ============================================================================
// LOGISTICS APPOINTMENT (Lojistik & Randevu Ağı)
// ============================================================================

model LogisticsAppointment {
  id              String   @id @default(cuid())
  title           String
  supplier        String
  type            String // DELIVERY, PICKUP, OTHER
  appointmentDate DateTime
  status          String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes           String?  @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([appointmentDate])
  @@index([status])
}

// ============================================================================
// DYNAMIC FORMS & SUBMISSIONS (Dinamik Denetim Formu Modülü)
// ============================================================================

model DynamicForm {
  id          String           @id @default(cuid())
  title       String // Örn: Yangın Tesisatı Denetim Formu
  description String?          @db.Text
  category    String?          @default("GENEL") // Yangın, İSG, Kalıp & Donatı, Elektrik, Genel
  fields      Json // Form alanları (Örn: [{ id, type, label, required, options }])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]

  @@index([category])
  @@index([createdAt])
}

model FormSubmission {
  id        String      @id @default(cuid())
  formId    String
  projectId String
  userId    String // Dolduran personel/denetçi
  answers   Json // Verilen cevaplar (Örn: { "f1": true, "f2": "Uygun", "f3": "https://..." })
  status    String      @default("COMPLETED") // COMPLETED, PENDING_REVIEW, REJECTED
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  form      DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// COMMON DATA & INTEGRATION LAYER (Ortak Veri ve Entegrasyon Katmanı)
// ============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  taxNumber String?
  address   String?  @db.Text
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  projects       Project[]
  companies      Company[]
  subcontractors Subcontractor[]
  workPackages   WorkPackage[]
  materials      Material[]
  auditLogs      AuditLog[]

  @@index([name])
  @@index([isActive])
}

model WorkPackage {
  id                String    @id @default(cuid())
  code              String? // Örn: "WP-101", "POZ-04.001"
  pozNo             String? // Örn: "15.150.1005"
  name              String // İş Paketi / İmalat Kalemi Adı
  categoryKey       String?   @default("statik") // "statik" | "mimari" | "elektrik" | "mekanik"
  description       String?   @db.Text
  unit              String?   @default("m3") // "m3" | "m2" | "mt" | "adet"
  unitPrice         Float     @default(0)
  plannedQuantity   Float     @default(0)
  completedQuantity Float     @default(0)
  totalBudget       Float?    @default(0)
  status            String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, ON_HOLD
  subcontractorName String?
  startDate         DateTime?
  endDate           DateTime?

  // BoQ 2.0 İnovatif Alanlar (Delta, AI Fire, 6D Karbon)
  theoreticalQuantity Float?   // BIM'den gelen saf teorik miktar
  aiWasteMargin     Float?     // AI tarafından öngörülen fire yüzdesi (Örn: 0.04 -> %4)
  actualOrderQty    Float?     // Fire dahil gerçek sipariş edilmesi gereken miktar
  carbonEmission    Float?     // Birim başına CO2 Karbon Ayak İzi (kg)
  totalCarbon       Float?     // Toplam CO2 salınımı
  version           Int        @default(1) // Revizyon takibi için (Delta BoQ)
  previousQuantity  Float?     // Mimari değişim öncesi miktar (Etki hesabı için)

  // Dinamik Fiyatlandırma & Enflasyon Simülatörü
  baseCurrency      String?  @default("TRY") // Orijinal para birimi
  exchangeRateAtBid Float?   // İhale tarihindeki kur
  currentUnitPrice  Float?   // Güncel API'den çekilen birim fiyat
  inflationImpact   Float?   // Enflasyon/Kur kaynaklı maliyet artışı

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Gantt görevleri
  tasks     ProjectTask[] @relation("WorkPackageTasks")
  siteTasks Task[]        @relation("WorkPackageSiteTasks")

  // 3D BIM kusur / ölçüm kayıtları
  bimIssues BimIssue[]

  // Hakediş satırları ve metraj pozları
  progressPayments ProgressPayment[]
  boqItems         BoQItem[]
  stockMovements   StockMovement[]

  // 3D BIM Eleman Eşleştirmesi (5D BIM)
  elements BimElementMap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([organizationId])
  @@index([status])
  @@index([code])
  @@index([pozNo])
  @@index([categoryKey])
}

model BoQItem {
  id                String @id @default(cuid())
  itemCode          String // Poz Numarası (Örn: "15.120.1001")
  description       String // Poz Açıklaması
  unit              String // m2, m3, ton, adet
  unitPrice         Float  @default(0)
  contractQuantity  Float  @default(0)
  completedQuantity Float  @default(0)
  totalAmount       Float  @default(0)

  // BoQ 2.0 İnovatif Alanlar
  theoreticalQuantity Float?   // BIM'den gelen saf teorik miktar
  aiWasteMargin     Float?     // AI tarafından öngörülen fire yüzdesi (Örn: 0.04 -> %4)
  actualOrderQty    Float?     // Fire dahil gerçek sipariş edilmesi gereken miktar
  carbonEmission    Float?     // Birim başına CO2 Karbon Ayak İzi (kg)
  totalCarbon       Float?     // Toplam CO2 salınımı
  version           Int        @default(1) // Revizyon takibi için (Delta BoQ)
  previousQuantity  Float?     // Mimari değişim öncesi miktar (Etki hesabı için)

  // Dinamik Fiyatlandırma & Enflasyon Simülatörü
  baseCurrency      String?  @default("TRY") // Orijinal para birimi
  exchangeRateAtBid Float?   // İhale tarihindeki kur
  currentUnitPrice  Float?   // Güncel API'den çekilen birim fiyat
  inflationImpact   Float?   // Enflasyon/Kur kaynaklı maliyet artışı

  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  progressPayments ProgressPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workPackageId])
  @@index([projectId])
  @@index([itemCode])
}

model Material {
  id            String  @id @default(cuid())
  code          String? @unique // Malzeme Kodu (Örn: "MAT-001")
  name          String // Malzeme Adı
  category      String? // Kaba Yapı, İnce Yapı, Elektrik, Tesisat vb.
  unit          String // kg, ton, m2, m3, adet
  description   String? @db.Text
  minStockLevel Float?  @default(0)
  costPrice     Float?  @default(0)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  stocks         Stock[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([category])
  @@index([organizationId])
}

model FinancialTransaction {
  id               String   @id @default(cuid())
  type             String // ACCRUAL, PAYMENT, EXPENSE, INCOME, DEBT
  amount           Float
  netAmount        Float?
  penaltyDeduction Float?   @default(0)
  taxAmount        Float?   @default(0)
  status           String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  description      String
  date             DateTime @default(now())
  category         String   @default("HAKEDIS") // HAKEDIS, MALZEME, AVANS, CEZA, KESINTI, DIGER

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  progressPaymentId String?
  progressPayment   ProgressPayment? @relation(fields: [progressPaymentId], references: [id], onDelete: SetNull)

  progressBillingId String?
  progressBilling   ProgressBilling? @relation(fields: [progressBillingId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([progressPaymentId])
  @@index([progressBillingId])
  @@index([projectId])
  @@index([subcontractorId])
  @@index([status])
  @@index([date])
}

model DocumentRevision {
  id              String           @id @default(cuid())
  documentId      String?
  document        Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectDocId    String?
  projectDocument ProjectDocument? @relation(fields: [projectDocId], references: [id], onDelete: Cascade)
  bimFileId       String?
  bimFile         BimFile?         @relation(fields: [bimFileId], references: [id], onDelete: SetNull)
  revisionNumber  String // Örn: "Rev-01", "v1.2"
  title           String?
  changeLog       String?          @db.Text
  fileUrl         String
  status          String           @default("APPROVED") // DRAFT, IN_REVIEW, APPROVED, REJECTED

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  approvalWorkflows ApprovalWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([projectDocId])
  @@index([bimFileId])
  @@index([revisionNumber])
  @@index([status])
}

model ApprovalWorkflow {
  id         String    @id @default(cuid())
  entityType String // PROGRESS_PAYMENT, DOCUMENT_REVISION, PURCHASE_ORDER, BIM_ISSUE, WORK_PACKAGE
  entityId   String // İlgili varlığın ID'si
  step       Int       @default(1)
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approverId String?
  approver   User?     @relation(fields: [approverId], references: [id], onDelete: SetNull)
  comment    String?   @db.Text
  approvedAt DateTime?

  documentRevisionId String?
  documentRevision   DocumentRevision? @relation(fields: [documentRevisionId], references: [id], onDelete: SetNull)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  progressPaymentId String?
  progressPayment   ProgressPayment? @relation(fields: [progressPaymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([approverId])
  @@index([status])
  @@index([documentRevisionId])
  @@index([purchaseOrderId])
  @@index([progressPaymentId])
}

model ApprovalRequest {
  id          String    @id @default(cuid())
  projectId   String
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  requestType String // "HAKEDIS", "REVIZYON", "SATINALMA", "KUSUR_KAPATMA"
  entityId    String
  requestedBy String
  status      String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  amount      Float?
  notes       String?   @db.Text
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId])
  @@index([status])
  @@index([requestType])
  @@index([createdAt])
}

model BimElementMap {
  id            String      @id @default(cuid())
  projectId     String
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId String
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  elementKey    String // IFC expressID veya GLTF mesh.name
  categoryKey   String // "statik" | "mimari" | "elektrik" | "mekanik"
  quantity      Float       @default(0) // 3D geometriden hesaplanan m3/m2 hacim
  status        String      @default("PLANNED") // "PLANNED", "IN_PROGRESS", "COMPLETED", "DEFECTIVE"
  updatedAt     DateTime    @updatedAt

  @@unique([projectId, elementKey])
  @@index([workPackageId])
  @@index([projectId])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  jobType     String // "BIM_METRAJ_INDEX", "DEFECT_RISK_SYNC", "AI_COLLECTION_CHECK"
  payload     Json
  status      String    @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  result      Json?
  error       String?   @db.Text
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([jobType])
  @@index([projectId])
}

// ============================================================================
// DRONE CAPTURE (4D Dijital İkiz & Fotogrametri)
// ============================================================================

model DroneCapture {
  id          String   @id @default(cuid())
  projectId   String
  stageName   String // Örn: "Zemin", "Karkas", "Kaba İnşaat"
  modelUrl    String // 3D Modelin (GLB/GLTF) URL'si
  captureDate DateTime
  progressPct Int // Örn: 25
  aiAnalysis  Json? // Array of annotations: [{ x, y, z, label, type }]
  createdAt   DateTime @default(now())

  @@index([projectId, captureDate])
}

// ============================================================================
// IOT, İSG VE LOJİSTİK (BLE Akıllı Zimmet & Canlı Şantiye Takibi)
// ============================================================================

model BleDevice {
  id           String    @id @default(cuid())
  macAddress   String    @unique
  deviceType   String // "BARET", "YELEK", "AYAKKABI", "YAKA_KARTI"
  assignedTo   String? // Personel ID
  userId       String?   @unique // Bir personelin 1 aktif bareti/yeleği olur
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  batteryLevel Int       @default(100)
  lastSeenAt   DateTime?
  projectId    String

  @@index([projectId])
  @@index([assignedTo])
  @@index([userId])
}

model RiskZone {
  id          String   @id @default(cuid())
  projectId   String
  zoneName    String // Örn: "A Blok İskele (Yüksekte Çalışma)", "Kule Vinç Altı"
  dangerLevel String // "HIGH", "CRITICAL"
  requiredPpe String[] // Örn: ["BARET", "EMNIYET_KEMERI"]

  @@index([projectId])
}

model IsgViolation {
  id         String   @id @default(cuid())
  projectId  String
  workerName String
  violation  String // Örn: "Baret takılmadı", "Yetkisiz iskele girişi"
  zoneName   String?
  timestamp  DateTime @default(now())
  status     String   @default("OPEN") // "OPEN", "RESOLVED"

  @@index([projectId])
  @@index([status])
  @@index([timestamp])
}

model DailyLogistics {
  id        String   @id @default(cuid())
  projectId String
  date      DateTime @default(now())
  material  String // "Demir (Ton)", "Çimento (Torba)", "Hazır Beton (m3)"
  incoming  Float    @default(0)
  consumed  Float    @default(0)

  @@index([projectId])
  @@index([date])
}

// ============================================================================
// METEOROLOJİK İSG RİSK TAHMİNİ & COMPUTER VISION KAMERA TESPİTLERİ
// ============================================================================

model WeatherForecast {
  id               String   @id @default(cuid())
  projectId        String
  forecastDate     DateTime
  windSpeed        Float // km/h
  rainProb         Float // %
  temperature      Float
  riskLevel        String // "LOW", "MODERATE", "HIGH", "CRITICAL"
  aiRecommendation String // Örn: "Rüzgar 55km/h - Kule Vinç İptal"
  historicalAvg    Float? // Son 3 yılın aynı gün/hafta ortalaması (Kıyas için)
  createdAt        DateTime @default(now())

  @@index([projectId, forecastDate])
  @@index([riskLevel])
}

model CameraViolation {
  id         String   @id @default(cuid())
  projectId  String
  cameraId   String // Örn: "VINC_KAMERA_1"
  violation  String // "NO_HELMET", "UNAUTHORIZED_ZONE"
  confidence Float // AI Güven skoru (Örn: 0.95)
  imageUrl   String? // Kanıt fotoğrafının URL'si
  timestamp  DateTime @default(now())
  status     String   @default("OPEN")

  @@index([projectId])
  @@index([status])
  @@index([timestamp])
}

model BlogPost {
  id             String   @id @default(cuid())
  title          String   // Başlık (H1)
  slug           String   @unique // URL dostu başlık (Örn: finansal-kacaklarin-onlenmesi)
  category       String   // Örn: "Case Study", "Haberler"
  targetAudience String   // Persona (Örn: "Patronlar, CFO'lar")
  content        String   // Zengin metin (HTML veya Markdown olarak saklanacak)
  imageUrl       String?  // Kapak fotoğrafı (UploadThing URL)
  author         String   @default("Nexa ERP")
  language       String   @default("tr") // "tr" veya "en"
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([language])
  @@index([createdAt])
}

// ============================================================================
// AI VE MAKİNE ÖĞRENMESİ (ML) MODELLERİ
// ============================================================================

model SubcontractorScore {
  id           String   @id @default(cuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id])
  speedScore   Float    // Hız puanı (1-10)
  qualityScore Float    // Kusur (BIM) puanı (1-10)
  isgRiskLevel String   // "LOW", "MEDIUM", "HIGH"
  lastUpdated  DateTime @default(now())

  @@index([companyId])
  @@index([isgRiskLevel])
}

model DailyAiReport {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  summaryText String   @db.Text // LLM'in yazdığı patron özeti
  riskTags    String[] // Örn: ["BÜTÇE RİSKİ", "HAVA MUHALEFETİ"]
  date        DateTime @default(now())

  @@index([projectId])
  @@index([date])
}

// ============================================================================
// 1. FİNANS: Çek, Senet ve Teminat Mektupları
// ============================================================================
model FinancialDocument {
  id            String   @id @default(cuid())
  documentType  String   // "CHECK" (Çek), "PROMISSORY_NOTE" (Senet), "GUARANTEE_LETTER" (Teminat Mektubu)
  documentNo    String   @unique
  amount        Float
  currency      String   @default("TRY")
  issueDate     DateTime
  dueDate       DateTime // Vade veya Bitiş Tarihi
  companyId     String   // Kime verildiği / Kimden alındığı
  company       Company  @relation(fields: [companyId], references: [id])
  status        String   @default("PORTFOLIO") // PORTFOLIO, CASHED, RETURNED, BOUNCED
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([documentType])
  @@index([dueDate])
  @@index([status])
}

// ============================================================================
// 2. TEDARİK: Satınalma Talebi ve Tedarikçi Teklifleri
// ============================================================================
model PurchaseRequest {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  materialName  String
  quantity      Float
  unit          String
  status        String        @default("OPEN_FOR_BID") // OPEN_FOR_BID, COMPLETED, CANCELLED
  bids          SupplierBid[]
  deliveryAppointments DeliveryAppointment[]
  shipmentTrackings    ShipmentTracking[]
  createdAt     DateTime      @default(now())

  @@index([projectId])
  @@index([status])
}

model SupplierBid {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  supplierId        String          // Company tablosundaki "SUPPLIER" ID'si
  supplier          Company         @relation(fields: [supplierId], references: [id])
  unitPrice         Float
  totalPrice        Float
  isWinningBid      Boolean         @default(false)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())

  @@index([purchaseRequestId])
  @@index([supplierId])
  @@index([isWinningBid])
}

// ============================================================================
// 3. İKMAL: Makine Yakıt ve Bakım Takibi
// ============================================================================
model EquipmentFuelRecord {
  id            String   @id @default(cuid())
  equipmentId   String   // İlgili iş makinesi / araç
  liters        Float
  cost          Float
  odometer      Int      // O anki Kilometre veya Çalışma Saati
  date          DateTime @default(now())

  @@index([equipmentId])
  @@index([date])
}

model EquipmentMaintenance {
  id              String   @id @default(cuid())
  equipmentId     String
  maintenanceType String   // "PERIODIC", "REPAIR", "INSPECTION" (Örn: MMO Vize)
  cost            Float
  nextDueDate     DateTime // Bir sonraki bakım tarihi (Risk Radarı İçin)
  isCompleted     Boolean  @default(false)

  @@index([equipmentId])
  @@index([nextDueDate])
  @@index([isCompleted])
}

// ============================================================================
// 4. İK: Süreli Evrak ve İSG Alarmı (Personel modeline veya ayrı tabloya)
// ============================================================================
model PersonnelDocument {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  docType       String   // "MYK", "HEAVY_MACHINE_LICENSE", "HEALTH_REPORT"
  issueDate     DateTime
  expiryDate    DateTime // Bitiş Tarihi
  isAlertSent   Boolean  @default(false)

  @@index([userId])
  @@index([expiryDate])
  @@index([docType])
}

// ============================================================================
// 5. LOJİSTİK VE AMBAR KABUL MODELLERİ
// ============================================================================

// Şantiye Kapı Randevu Sistemi (Trafik Kontrolü)
model DeliveryAppointment {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  supplierId        String
  vehiclePlate      String   // Tır/Kamyon Plakası
  driverName        String?
  scheduledDate     DateTime // Randevu Tarihi ve Saati
  status            String   @default("SCHEDULED") // SCHEDULED, ARRIVED, UNLOADED, REJECTED
  createdAt         DateTime @default(now())

  @@index([purchaseRequestId])
  @@index([scheduledDate])
  @@index([status])
}

// Ambar Kabul ve İrsaliye Eşleştirme
model GoodsReceipt {
  id                String   @id @default(cuid())
  purchaseRequestId String
  orderedQuantity   Float
  deliveredQuantity Float    // Gerçekte ambara inen miktar
  waybillNo         String   // İrsaliye Numarası
  receivedById      String   // Teslim alan personel (User ID)
  receivedDate      DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([purchaseRequestId])
  @@index([waybillNo])
  @@index([receivedById])
}

// Canlı Lojistik ve Sevkiyat Takibi
model ShipmentTracking {
  id                String          @id @default(cuid())
  trackingCode      String          @unique // URL'de kullanılacak eşsiz kod (Örn: 8f7a9)
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  driverPhone       String          // SMS atılacak numara
  vehiclePlate      String
  status            String          @default("PREPARING") // PREPARING, ON_THE_WAY, ARRIVED, DELIVERED
  lastLatitude      Float?          // Son ping (Enlem)
  lastLongitude     Float?          // Son ping (Boylam)
  updatedAt         DateTime        @updatedAt
  createdAt         DateTime        @default(now())

  @@index([trackingCode])
  @@index([purchaseRequestId])
  @@index([status])
}





